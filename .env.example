# ── SendBox · Instagram API (built on Meta's official Instagram API) ──────
# ۱) کلید API → برای هدر X-Api-Key (لیست پست‌ها، کامنت، ارسال پیام)
BOXAPI_API_KEY=
# ۲) توکن ورود → برای پارامتر token در لینک ورود اینستاگرام
#    (همان توکنی که در «لینک ورود اینستاگرام» می‌آید؛ با کلید API یکی نیست)
BOXAPI_LOGIN_TOKEN=
# آدرس پایه‌ی API
BOXAPI_BASE_URL=https://api.sendbox.chat/api/v1
# آدرس صفحه‌ی ورود اینستاگرام
BOXAPI_LOGIN_URL=https://api.sendbox.chat
# دامنه‌ی اپ شما (همان آدرس عمومی/تونل) — نه دامنه‌ی SendBox
BOXAPI_DOMAIN=
# اگر پنل Secret وبهوک می‌دهد (مثل whsec_...)، همین جا
BOXAPI_WEBHOOK_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
# آدرس عمومی (HTTPS) اپ — همین آدرس + مسیرهای زیر در پنل SendBox ثبت می‌شود:
#   Login Redirect URL : {APP_URL}/api/boxapi/callback
#   Webhook URL        : {APP_URL}/api/boxapi/webhook
APP_URL=http://localhost:3000

# true = حالت دمو (بدون نیاز به کلید)
DEMO_MODE=true

# مسیر فایل دیتابیس SQLite
DB_PATH=./data/app.db
