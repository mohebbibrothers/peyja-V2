# ── BoxAPI · Official Instagram API ─────────────────────────────────────
# توکن دسترسی را از پنل BoxAPI → «تنظیمات API رسمی اینستاگرام» کپی کنید
BOXAPI_API_KEY=
# آدرس پایه‌ی لینک ورود (پیش‌فرض https://boxapi.ir)
BOXAPI_LOGIN_URL=https://boxapi.ir
# دامنه‌ای که در پنل BoxAPI ثبت کردید (فقط جهت نمایش/راهنما)
BOXAPI_DOMAIN=
# اگر در پنل Webhook Secret گرفتید، همین جا هم بگذارید (توصیه می‌شود)
BOXAPI_WEBHOOK_SECRET=
# آدرس پایه‌ی API (معمولاً بدون تغییر)
BOXAPI_BASE_URL=https://boxapi.ir/api/instagram

# ── App ─────────────────────────────────────────────────────────────────
# آدرس عمومی (HTTPS) اپ — همین آدرس + مسیرهای زیر در پنل BoxAPI ثبت می‌شود:
#   Login Redirect URL : {APP_URL}/api/boxapi/callback
#   Webhook URL        : {APP_URL}/api/boxapi/webhook
APP_URL=http://localhost:3000

# true = حالت دمو (بدون نیاز به کلید BoxAPI)
DEMO_MODE=true

# مسیر فایل دیتابیس SQLite
DB_PATH=./data/app.db
